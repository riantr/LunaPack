import {
  "moonbitlang/core/encoding/utf16",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/compress/gzip",
  "moonbitlang/core/compress/flate",
}

pkgtype(kind: "foreign_library")

supported_targets = "native"

// The virtual-registry thunks fall through to the real advapi32 entry points.
// `moon test` links a test executable for this package, so the import library
// has to be present there too. This module is Windows-only and is never built
// by the root module's Linux/macOS/wasm jobs.
//
// ntdll.lib is for NtQueryKey: a runtime that already holds a real key handle
// (combase caches the classes root this way) can only be answered if that
// handle is translated back into a path.
//
// oleaut32.lib is for the type-library thunks (L5.6). They fall through to the
// real LoadTypeLibEx / RegisterTypeLib for a path that is not in the archive,
// which is the behaviour a component that ships a real .tlb expects.
//
// bcrypt.lib is for the SHA-256 a bundle's manifest asks for, and for the same
// reason the launcher names it: a bundle is checked before it runs.
//
// gzip and flate are how a bundle stores an entry that compressed. The archive
// reader in `bundle.mbt` decodes those, and it lives in this package because
// the process that decodes them is the one the mapped runtime is in.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/compress/gzip",
    "moonbitlang/core/compress/flate",
  ],
  link: {
    "native": {
      "cc-link-flags": "advapi32.lib ntdll.lib oleaut32.lib bcrypt.lib",
    },
  },
)
